# --- Required ---
# Postgres. Local: run `npm run db` and keep these values.
# Supabase (Project → Connect → ORMs → Prisma):
#   DATABASE_URL = Transaction pooler, port 6543, ending in ?pgbouncer=true
#   DIRECT_URL   = Session pooler / direct connection, port 5432
# Sharing the database with another app? Add schema=ph_jobs to both URLs (&schema=ph_jobs / ?schema=ph_jobs)
# so this project gets its own tables and never touches the other app's "public" tables.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ph_jobs
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/ph_jobs
# Only for `npm run migrate:mongo` (copying data from the old MongoDB version of the project).
# MONGODB_URI=mongodb://127.0.0.1:27017/ph-jobs
# Apify API token(s): https://console.apify.com/settings/integrations
# Several tokens, comma-separated: used in order, switching automatically when one runs out of credit.
APIFY_TOKENS=
# (single-token setups may use APIFY_TOKEN instead)
APIFY_TOKEN=
# Password for /admin and the ingest endpoints (any long random string)
ADMIN_TOKEN=

# --- Optional ---
# Enables the Claude classifier/extractor (needed for good Facebook results).
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. A cheaper model (e.g. claude-haiku-5-5) cuts cost for high volume.
CLAUDE_MODEL=
# Public URL of this app + a secret → Apify calls /api/ingest/webhook when runs finish (faster than waiting for the next tick).
PUBLIC_BASE_URL=
WEBHOOK_SECRET=
# Bearer token Vercel Cron sends to /api/ingest/tick
CRON_SECRET=
# Local scheduler interval
TICK_MINUTES=5
