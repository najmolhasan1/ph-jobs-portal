{
  "name": "ph-jobs-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db": "tsx scripts/dev-db.mts",
    "typecheck": "tsc --noEmit",
    "replay": "tsx --env-file=.env.local scripts/replay.mts",
    "rescore": "tsx --env-file=.env.local scripts/rescore.mts",
    "worker": "tsx --env-file=.env.local scripts/worker.mts",
    "check": "tsx --env-file=.env.local scripts/check.mts",
    "retag": "tsx --env-file=.env.local scripts/retag.mts",
    "sync-config": "tsx --env-file=.env.local scripts/sync-config.mts",
    "db:mongo": "tsx scripts/mongo-db.mts",
    "db:push": "node --env-file=.env.local node_modules/prisma/build/index.js db push",
    "migrate:mongo": "tsx --env-file=.env.local scripts/migrate-from-mongo.mts",
    "postinstall": "prisma generate",
    "copy-db": "tsx --env-file=.env.local scripts/copy-db.mts",
    "backfill": "tsx --env-file=.env.local scripts/backfill.mts",
    "market": "tsx --env-file=.env.local scripts/market.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@prisma/client": "^6.19.3",
    "@vercel/analytics": "^2.0.1",
    "apify-client": "^2.25.0",
    "next": "^15.5.28",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "mongodb-memory-server": "^10.4.3",
    "mongoose": "^8.24.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
